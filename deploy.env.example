# Copy to deploy.env (untracked) and fill in. Read by scripts/deploy-hub.sh and `tabdeck install-agent`.
HUB_HOST=user@hub-host        # ssh target of the hub server
HUB_IP=192.0.2.10             # its NetBird (or other private VPN) IP; the hub serves https://HUB_IP:HUB_PORT
HUB_FQDN=                     # optional: its VPN name, added to its certificate
# HUB_REPO=tabdeck            # the checkout folder on the server (default tabdeck, or tabdeck-<instance>)
# HUB_PORT=8765
# HUB_AGENT=claude            # claude or opencode
# HUB_SESSION=deck            # tmux session holding one window per agent session
# HUB_ASSISTANT=Jarvis        # the assistant's name, and its wake word:
# HUB_WAKE=jarvis
# HUB_ODS=1                   # the server runs ODS: use its model, Whisper and Kokoro (and OpenCode on ODS's model)
# TABDECK_INSTANCE=gpu        # a second setup next to the first: ~/.tabdeck-gpu, its own launchd jobs and cron
